{
  "name": "linkxtr/filament-qr",
  "description": "A clean, modern Filament plugin to generate, render, style, and export QR codes powered by linkxtr/laravel-qrcode",
  "license": "MIT",
  "keywords": [
    "linkxtr",
    "laravel",
    "filament",
    "filament-plugin",
    "qrcode",
    "qr-code"
  ],
  "authors": [
    {
      "name": "Khaled Sadek",
      "email": "khaledsadek286@gmail.com",
      "homepage": "https://github.com/khaled-sadek"
    }
  ],
  "homepage": "https://github.com/Linkxtr/filament-qr",
  "require": {
    "php": "^8.2",
    "filament/filament": "^3.0 || ^4.0 || ^5.0",
    "illuminate/contracts": "^12.0 || ^13.0",
    "illuminate/support": "^12.0 || ^13.0",
    "linkxtr/laravel-qrcode": "^3.0"
  },
  "require-dev": {
    "ergebnis/composer-normalize": "^2.54",
    "laravel/pao": "^1.1",
    "laravel/pint": "^1.0",
    "orchestra/testbench": "^10.0 || ^11.0",
    "pestphp/pest": "^3.0 || ^4.0",
    "pestphp/pest-plugin-laravel": "^3.0 || ^4.0",
    "pestphp/pest-plugin-type-coverage": "^3.0 || ^4.0",
    "phpstan/phpstan": "^2.0",
    "rector/rector": "^1.0 || ^2.0"
  },
  "suggest": {
    "ext-gd": "Required to generate PNG and WebP images via GD",
    "ext-imagick": "Required to generate PNG and WebP images via Imagick"
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "autoload": {
    "psr-4": {
      "Linkxtr\\FilamentQr\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Linkxtr\\FilamentQr\\Tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "ergebnis/composer-normalize": true,
      "pestphp/pest-plugin": true,
      "phpstan/extension-installer": true
    },
    "sort-packages": true
  },
  "extra": {
    "laravel": {
      "providers": [
        "Linkxtr\\FilamentQr\\FilamentQrServiceProvider"
      ]
    }
  },
  "scripts": {
    "lint": "pint --parallel",
    "mutate": [
      "Composer\\Config::disableProcessTimeout",
      "pest --parallel --mutate --covered-only"
    ],
    "refactor": "rector",
    "test": [
      "@test:refactor",
      "@test:lint",
      "@test:types",
      "@test:type-coverage",
      "@test:unit"
    ],
    "test:lint": "pint --parallel --test",
    "test:refactor": "rector --dry-run",
    "test:type-coverage": "pest --type-coverage --compact --coverage --min=100",
    "test:types": "phpstan analyse --ansi",
    "test:unit": "pest --parallel --colors=always --coverage --min=86.5 --coverage-clover build/logs/clover.xml"
  }
}